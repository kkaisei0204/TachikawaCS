# ============================================
# 正しい .gitignore ファイル
# ============================================

# Python バイトコーチE
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# 仮想環墁E
venv/
env/
ENV/
.venv/

# 環墁E  数ファイル E 機寁E  報 E E
.env
.flaskenv

# チE Eタベ Eス E 開発環墁E  は含めてもOKだが、本番DBは除外！E
# 開発用にコミットしたい場合 EコメントアウチE

# ログファイル
*.log

# IDE設宁E
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS固朁E
.DS_Store
Thumbs.db
desktop.ini
*.bak

# Flask
instance/
.webassets-cache

# キャチE  ュ
.cache/
.pytest_cache/

# ビルド E果物
dist/
build/
*.egg-info/
*.egg

# カバレチE  
htmlcov/
.coverage
.coverage.*
.tox/

# Node E もし使ってぁE  ば E E
node_modules/
npm-debug.log
yarn-error.log

# バックアチE Eファイル
*.backup
*.bak
*~

# アチE Eロードされた画像（容量が大きい場合 Eみ除外！E
# 開発環墁E  共有したい場合 EコメントアウチE
# apps/top_page/static/uploads/icons/*.png
# apps/top_page/static/uploads/icons/*.jpg
# apps/top_page/static/uploads/icons/*.jpeg
# apps/main_app/uploads/*

# Git関連
.git/
.gitattributes
