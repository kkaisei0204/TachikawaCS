<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>トピックス - 立川混雑シェア</title>
  
  <!-- 外部CSS -->
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <link rel="manifest" href="/static/manifest.json">
  <meta name="theme-color" content="#667eea">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="混雑シェア">
  
  <style>
    /* スマホ対応：メニュー修正 */
    .menu-outer01 {
      position: fixed;
      top: 0;
      right: -100%;
      width: auto;
      min-width: 200px;
      max-width: 80%;
      height: 100vh;
      background: #fff;
      transition: right 0.3s;
      z-index: 999;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      padding: 60px 0 20px;
    }
    
    .menu-outer01.active {
      right: 0;
      overflow: hidden !important;
    }
    
    .sample_menu_list01 {
      list-style: none;
      padding: 0;
      margin: 0;
      flex: 1;
      overflow: hidden !important;
    }
    
    .sample_menu_list01 li {
      width: 100%;
      border-bottom: none !important;
      border-top: none !important;
    }
    
    .sample_menu_list01 a {
      display: block;
      padding: 15px 25px !important;
      font-size: 14px !important;
      color: #333 !important;
      white-space: nowrap;
      text-decoration: none;
    }
    
    .sample_menu_list01 a:hover {
      background: #f5f5f5;
    }
    
    /* ユーザー情報エリア */
    .sample_menu_list01 .user-info {
      margin-top: auto;
      border-top: none !important;
      background: #fff !important;
      padding: 20px 25px !important;
      position: relative;
    }
    
    .sample_menu_list01 .user-info .user-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      color: #2d3748 !important;
      text-decoration: none !important;
      white-space: nowrap;
    }
    
    .sample_menu_list01 .user-icon-img {
      width: 40px !important;
      height: 40px !important;
      border-radius: 50%;
      border: 2px solid #667eea;
      flex-shrink: 0;
    }
    
    /* メニューオーバーレイ */
    .menu-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 998;
    }
    
    .menu-overlay.active {
      display: block;
    }
    
    /* 背景スクロール防止 */
    body.menu-open {
      overflow: hidden;
    }
  </style>
</head>
<body>
  <header>
    <div class="app_name">
      <h1>立川混雑シェア</h1>
    </div>
    <!-- モバイル用ハンバーガーメニューボタン -->
    <button class="mobile-menu-toggle" id="mobileMenuToggle">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="menu-outer01">
      <ul class="sample_menu_list01">
        <li><a href="{{ url_for('main.index') }}">トップ</a></li>
        <li><a href="{{ url_for('topics.topics_page') }}">トピックス</a></li>
        <li><a href="{{ url_for('main.index') }}#map">地図を見る</a></li>
        {% if current_user.is_authenticated %}
          <li><a href="{{ url_for('post.post_page') }}">投稿</a></li>
          <li><a href="{{ url_for('main.logout') }}">ログアウト</a></li>
          {% if current_user.is_admin %}
            <li><a href="{{ url_for('main.admin_panel') }}">管理者パネル</a></li>
          {% endif %}
          <!-- ユーザー情報は最下部 -->
          <li class="user-info">
            <a href="{{ url_for('main.user_page', username=current_user.username) }}" class="user-link">
              <img src="{{ url_for('static', filename=current_user.icon_path) }}" alt="{{ current_user.username }}" class="user-icon-img">
              <span>{{ current_user.username }}</span>
            </a>
          </li>
        {% else %}
          <li><a href="{{ url_for('main.login') }}">ログイン</a></li>
          <li><a href="{{ url_for('main.register') }}">新規登録</a></li>
        {% endif %}
      </ul>        
    </div>
  </header>
  <div class="menu-overlay" id="menuOverlay"></div>
  

  
  <!-- フラッシュメッセージ表示 -->
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
      <div class="flash-messages">
        {% for category, message in messages %}
          <div class="flash {{ category }}">{{ message }}</div>
        {% endfor %}
      </div>
    {% endif %}
  {% endwith %}
  
  <div class="container">
    <!-- お知らせセクション -->
    <div class="notice-section">
      <h2>お知らせ</h2>
      <p>立川市内の混雑状況をリアルタイムで共有できるサービスです。</p>
      <div style="margin-top: 15px; padding: 15px; background-color: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px;">
        <strong style="color: #856404;">🍺 NEW!</strong> 
        <a href="{{ url_for('main.oharatei') }}#reserve" style="color: #856404; font-weight: 600; text-decoration: underline;">大原亭のオンライン予約</a>が始まりました！
      </div>
    </div>
    
    <!-- トピックスセクション -->
    <div class="topics-section">
      <h2>最近の投稿（1時間以内）</h2>
      {% if recent_posts %}
        <div class="posts-grid">
          {% for post in recent_posts %}
            <div class="post-card" id="post-{{ post.post_id }}">
              <div class="post-card-header">
                <a href="{{ url_for('main.user_page', username=post.user_name) }}" class="username-link">
                  <strong>{{ post.user_name }}</strong>
                </a>
                {% if post.user_avg_rating is not none %}
                  <span class="user-rating-small">
                    {% set stars = ((post.user_avg_rating / 100 * 5) | round | int) %}
                    {% for i in range(stars) %}★{% endfor %}{% for i in range(5 - stars) %}☆{% endfor %}
                  </span>
                {% endif %}
              </div>
              <div class="post-card-body">
                <div class="shop-name">{{ post.shop_name }}</div>
                <div class="crowd-status status-{{ post.crowd_level }}">{{ post.crowd_level }}</div>
                <div class="post-comment">{{ post.comment }}</div>
              </div>
              <div class="post-card-footer">
                <span class="post-time">{{ post.time_ago }}</span>
                <div class="post-ratings">
                  {% if current_user.is_authenticated %}
                    <button 
                      class="rating-btn helpful-btn {% if post.user_rated == 1 %}active{% endif %}" 
                      data-post-id="{{ post.post_id }}" 
                      data-rating="1"
                      {% if post.user_rated is not none %}disabled{% endif %}>
                      👍 <span class="count">{{ post.helpful_count }}</span>
                    </button>
                    <button 
                      class="rating-btn not-helpful-btn {% if post.user_rated == 0 %}active{% endif %}" 
                      data-post-id="{{ post.post_id }}" 
                      data-rating="0"
                      {% if post.user_rated is not none %}disabled{% endif %}>
                      👎 <span class="count">{{ post.not_helpful_count }}</span>
                    </button>
                  {% else %}
                    <span class="post-ratings-mini">
                      👍 {{ post.helpful_count }} 👎 {{ post.not_helpful_count }}
                    </span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="no-posts-message">1時間以内の投稿がありません。ログインして最新の混雑情報を投稿してみましょう！</p>
      {% endif %}
    </div>
  </div>
    
    <!-- 店舗紹介セクション -->
    <div class="shops-intro-section">
      <h2>立川市の全店舗紹介</h2>
      <p class="section-description">立川エリアで投稿可能な全{{ shops|length }}店舗をご紹介します</p>
      
      <div class="shop-cards-grid">
        {% for shop in shops %}
          <div class="shop-intro-card">
            <div class="shop-intro-header">
              <h3 class="shop-intro-name">{{ shop.name }}</h3>
              <span class="shop-category-badge">{{ shop.category }}</span>
            </div>
            <div class="shop-intro-body">
              <p class="shop-intro-description">{{ shop.description }}</p>
              {% if shop.signature %}
                <div class="shop-signature">
                  <span class="signature-label">看板メニュー：</span>
                  <span class="signature-text">{{ shop.signature }}</span>
                </div>
              {% endif %}
            </div>
            {% if shop.url %}
              <div class="shop-intro-footer">
                <a href="{{ shop.url }}" target="_blank" class="shop-website-link">公式サイト →</a>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  
  <footer>
    <p>© 2025 立川混雑シェアマップ</p>
  </footer>
  
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const ratingButtons = document.querySelectorAll('.rating-btn');

    ratingButtons.forEach(btn => {
      btn.addEventListener('click', async function () {
        const postId = this.dataset.postId;
        const rating = this.dataset.rating;

        const postCard = document.getElementById(`post-${postId}`);
        if (!postCard) return;

        const helpfulBtn = postCard.querySelector('[data-rating="1"]');
        const notHelpfulBtn = postCard.querySelector('[data-rating="0"]');

        // 連打防止（通信前にロック）
        helpfulBtn.disabled = true;
        notHelpfulBtn.disabled = true;
        this.classList.add('active');

        try {
          const response = await fetch(`/topics/rate/${postId}/${rating}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          // 500とかで落ちた時にJSが死なないように
          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }

          const data = await response.json();

          if (!data.success) {
            alert(data.error || "評価に失敗しました");
            // 失敗なら押し直せるように戻す
            helpfulBtn.disabled = false;
            notHelpfulBtn.disabled = false;
            this.classList.remove('active');
            return;
          }

          // カウントだけ更新（ページ更新なし）
          helpfulBtn.querySelector('.count').textContent = data.helpful_count;
          notHelpfulBtn.querySelector('.count').textContent = data.not_helpful_count;

          // 成功したらロック維持（1人1回の仕様）
        } catch (err) {
          console.error(err);
          alert("通信に失敗しました");
          // 通信エラーならやり直せるように戻す
          helpfulBtn.disabled = false;
          notHelpfulBtn.disabled = false;
          this.classList.remove('active');
        }
      });
    });
  });
  </script>

  <script>
    // モバイルメニュートグル
    const menuToggle = document.getElementById('mobileMenuToggle');
    const menuOuter = document.querySelector('.menu-outer01');
    const menuOverlay = document.getElementById('menuOverlay');
    
    if (menuToggle && menuOuter && menuOverlay) {
      menuToggle.addEventListener('click', function() {
        this.classList.toggle('active');
        menuOuter.classList.toggle('active');
        menuOverlay.classList.toggle('active');
        document.body.classList.toggle('menu-open');
      });
      
      menuOverlay.addEventListener('click', function() {
        menuToggle.classList.remove('active');
        menuOuter.classList.remove('active');
        this.classList.remove('active');
        document.body.classList.remove('menu-open');
      });
      
      // メニュー項目クリック時に閉じる
      const menuLinks = menuOuter.querySelectorAll('a');
      menuLinks.forEach(link => {
        link.addEventListener('click', function() {
          menuToggle.classList.remove('active');
          menuOuter.classList.remove('active');
          menuOverlay.classList.remove('active');
          document.body.classList.remove('menu-open');
        });
      });
    }
  </script>

</body>
</html>